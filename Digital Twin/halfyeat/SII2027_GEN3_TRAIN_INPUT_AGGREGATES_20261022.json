  "formulas": {
    "support": "Only frozen real TRAIN x/y_angles unique frames [100:-100] once per parent; no replay/virtual values in distribution statistics.",
    "windows": "starts=range(0,n-120+1,20); append n-120 if absent. Four-slot windows Wp=4*sum_trial len(starts(ntrial)); both GEN1 source domains have this lineage.",
    "loss_mass": "Within fold p: wp=Wp/sum_source Wp. Uniform shuffled per-window MSE gives expected share wp of batch-mean loss coefficients. This is sampling/loss opportunity, not measured gradient norms or causal performance contribution.",
    "batch_caveat": "Each optimizer step averages 120*6*batch_size elements. Last batch can be smaller. Because shuffle is uniform, the expectation of the sum of sample coefficients per epoch for patient p is ceil(W/64)*wp. Actual residuals, directions, clipping, AdamW and shuffle realizations are not estimated.",
    "all_G_exposures": "For each source membership: 200 epochs * 2 source domains * 3 seeds * Wp. Sum over six folds excluding a target entirely; source windows for mixed have only lineage counted, no virtual files opened.",
    "all_G_expected_loss_coefficient": "Sum_fold 200*2*3*ceil(Wfold/64)*wp. Normalize by 195600 planned G steps for share across all source updates.",
    "Kish_effective_patients": "Neff=1/sum_source(wp^2), nominal source patients=7. Windows overlap and replay; this is a weight-concentration index, not independent clinical sample size.",
    "source_scaler": "Source7 pooled unique TRAIN crop frames, mu_s=mean(Xs), sd_s=std(Xs,ddof=0); denominator max(sd_s,1e-5), exactly matching GEN1 support; report float64 statistics, with a reconstruction of the frozen float32 scaler algorithm and its rounding-effect check; no stored checkpoint scaler is opened or directly compared.",
    "input_mean_gap": "(mu_target-mu_source)/max(sd_source,1e-5), per native channel; overall mean-gap RMS=sqrt(mean_channel(gap^2)).",
    "input_scale_gap": "ratio=sd_target/max(sd_source,1e-5), relative_gap=(sd_target-sd_source)/max(sd_source,1e-5); ratio and log2(ratio) per channel.",
    "sensor_direction": "acos(clip(dot(mean_acc_target,mean_acc_source)/(norm(mean_acc_target)*norm(mean_acc_source)),-1,1))*180/pi, separately S1 and S2. Means combine gravity projection, dynamic acceleration, gait/posture/time mix, offset and native-axis installation; cannot estimate static gravity or a sensor-to-body rotation.",
    "gyro_RMS": "Native XYZ channel RMS=sqrt(mean(w_j^2)); vector RMS=sqrt(mean(sum_j w_j^2)); mean and centered vector RMS separately retained.",
    "label_mean_gap": "Target minus source7 pooled unique TRAIN crop label mean, each fixed legacy engineering angle in degrees; also source-label-SD standardized gap. Diagnostic only.",
    "label_ROM_gap": "Report pooled span, q95-q05 and arithmetic mean of trial(max-min) separately. Compare target and source trial-equal ROM; pooled span mixes trials and should not be treated as a gait-cycle ROM.",
    "public_aggregation": "Public files contain cross-fold/patient distribution summaries only, no patient IDs, parent IDs, paths or individual fold rows. Local files preserve evidence and identifiers. Small aggregates are not a formal anonymization guarantee."
  },
  "limitations": [
    "This is a TRAIN-only descriptive diagnosis. No validation/test predictions or accuracy were read; no assertion of improved generalization or target error explanation follows.",
    "Dynamic walking mean acceleration is a gait/posture/time-mixture and installation/offset candidate difference, not a static-gravity calibration. Native sensor XYZ axes are not a certified shared anatomical frame.",
    "Patient source mass counts opportunities in the frozen MSE objective, not actual gradient size or causal usefulness. Replayed overlapping windows are not new independent samples.",
    "Legacy engineering angle labels and trial-level spans are not certified clinical JCS or gait-cycle ROM. Label statistics are diagnostic and cannot justify relabeling.",
    "Only six target folds and eight training patients; no formal population inference, distribution-distance significance claim or privacy guarantee from aggregation.",
    "This script opens no held-out dynamics. Prior frozen study work already used held-out data; this diagnosis does not claim that TEST was globally untouched or independent of all earlier exploratory decisions."
  ],
  "candidate_next_experiments_TRAIN_only": [
    {
      "candidate": "equal_patient_source_loss",
      "rationale": "Frozen source window weights concentrate loss opportunity; average per-patient window loss equally, leaving data, coordinates, labels, crop and model unchanged.",
